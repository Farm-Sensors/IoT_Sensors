{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edge-cloud telemetry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "soil",
    "irrigation",
    "environmental"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "soil": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conductivity",
        "temperature",
        "humidity",
        "water_potential"
      ],
      "properties": {
        "conductivity": {
          "type": [
            "number",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "humidity": {
          "type": [
            "number",
            "null"
          ]
        },
        "water_potential": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "irrigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "accumulated_liters",
        "flow_per_minute"
      ],
      "properties": {
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "accumulated_liters": {
          "type": [
            "number",
            "null"
          ]
        },
        "flow_per_minute": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "environmental": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "relative_humidity",
        "wind_speed",
        "solar_radiation",
        "eto"
      ],
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_humidity": {
          "type": [
            "number",
            "null"
          ]
        },
        "wind_speed": {
          "type": [
            "number",
            "null"
          ]
        },
        "solar_radiation": {
          "type": [
            "number",
            "null"
          ]
        },
        "eto": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
