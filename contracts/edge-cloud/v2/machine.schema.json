{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edge-cloud v2 machine message definitions",
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "activationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_reference"
      ],
      "properties": {
        "activation_reference": {
          "type": "string",
          "pattern": "^ar_.+$"
        }
      }
    },
    "activationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway_id",
        "property_id",
        "credential"
      ],
      "properties": {
        "gateway_id": {
          "type": "integer",
          "minimum": 1
        },
        "property_id": {
          "type": "integer",
          "minimum": 1
        },
        "credential": {
          "type": "string",
          "pattern": "^gk_.+$"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "logical_node_id",
        "irrigation_area_id",
        "hardware_profile_code"
      ],
      "properties": {
        "slot_id": {
          "type": "integer",
          "minimum": 1
        },
        "logical_node_id": {
          "type": "integer",
          "minimum": 1
        },
        "irrigation_area_id": {
          "type": "integer",
          "minimum": 1
        },
        "hardware_profile_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "uid",
        "serial",
        "submitted_at",
        "confirmed_at"
      ],
      "properties": {
        "candidate_id": {
          "type": "integer",
          "minimum": 1
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "submitted_at": {
          "$ref": "#/$defs/utc"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "overlaySlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "logical_node_id",
        "irrigation_area_id",
        "binding_status",
        "current_binding",
        "pending_binding"
      ],
      "properties": {
        "slot_id": {
          "type": "integer",
          "minimum": 1
        },
        "logical_node_id": {
          "type": "integer",
          "minimum": 1
        },
        "irrigation_area_id": {
          "type": "integer",
          "minimum": 1
        },
        "binding_status": {
          "enum": [
            "unbound",
            "pending_initial",
            "confirmed",
            "pending_reassignment"
          ]
        },
        "current_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "configurationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_version",
        "bindings_revision",
        "property_id",
        "configuration",
        "binding_overlay",
        "cloud_status",
        "edge_status"
      ],
      "properties": {
        "configuration_version": {
          "type": "integer",
          "minimum": 0
        },
        "bindings_revision": {
          "type": "integer",
          "minimum": 0
        },
        "property_id": {
          "type": "integer",
          "minimum": 1
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gateway_id",
            "property_id",
            "slots"
          ],
          "properties": {
            "gateway_id": {
              "type": "integer",
              "minimum": 1
            },
            "property_id": {
              "type": "integer",
              "minimum": 1
            },
            "slots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/slot"
              }
            }
          }
        },
        "binding_overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slots"
          ],
          "properties": {
            "slots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/overlaySlot"
              }
            }
          }
        },
        "cloud_status": {
          "enum": [
            "inactive",
            "never_seen",
            "recently_seen",
            "stale",
            "disconnected"
          ]
        },
        "edge_status": {
          "enum": [
            "pending",
            "connected",
            "delayed",
            "disconnected"
          ]
        }
      }
    },
    "candidateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "logical_node_id",
        "irrigation_area_id",
        "uid",
        "serial"
      ],
      "properties": {
        "slot_id": {
          "type": "integer",
          "minimum": 1
        },
        "logical_node_id": {
          "type": "integer",
          "minimum": 1
        },
        "irrigation_area_id": {
          "type": "integer",
          "minimum": 1
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "serial": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "slot_id",
        "binding_status",
        "submitted_at"
      ],
      "properties": {
        "candidate_id": {
          "type": "integer",
          "minimum": 1
        },
        "slot_id": {
          "type": "integer",
          "minimum": 1
        },
        "binding_status": {
          "enum": [
            "pending_initial",
            "pending_reassignment"
          ]
        },
        "submitted_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "confirmationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "technician_confirmed_at"
      ],
      "properties": {
        "slot_id": {
          "type": "integer",
          "minimum": 1
        },
        "technician_confirmed_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "confirmationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "slot_id",
        "binding_status",
        "confirmed_at"
      ],
      "properties": {
        "candidate_id": {
          "type": "integer",
          "minimum": 1
        },
        "slot_id": {
          "type": "integer",
          "minimum": 1
        },
        "binding_status": {
          "const": "confirmed"
        },
        "confirmed_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "readingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "timestamp",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "node_id": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "$ref": "#/$defs/utc"
        },
        "created_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "updateAuthorizationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "image_version",
        "image_digest",
        "expires_at"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "image_version": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "updateConfirmationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "image_version",
        "image_digest",
        "technician_confirmed_at",
        "result"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "image_version": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "minLength": 1
        },
        "technician_confirmed_at": {
          "$ref": "#/$defs/utc"
        },
        "result": {
          "const": "confirmed"
        }
      }
    },
    "updateConfirmationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authorization_id",
        "image_version",
        "image_digest",
        "technician_confirmed_at",
        "result"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "image_version": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "minLength": 1
        },
        "technician_confirmed_at": {
          "$ref": "#/$defs/utc"
        },
        "result": {
          "const": "confirmed"
        }
      }
    },
    "gatewayHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "X-API-Key"
      ],
      "properties": {
        "X-API-Key": {
          "type": "string",
          "pattern": "^gk_.+$"
        },
        "X-Request-ID": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "activationHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Content-Type"
      ],
      "properties": {
        "Content-Type": {
          "const": "application/json"
        },
        "X-Request-ID": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "jsonHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "X-API-Key",
        "Content-Type"
      ],
      "properties": {
        "X-API-Key": {
          "type": "string",
          "pattern": "^gk_.+$"
        },
        "X-Request-ID": {
          "type": "string",
          "minLength": 1
        },
        "Content-Type": {
          "const": "application/json"
        }
      }
    },
    "eventHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "X-API-Key",
        "Content-Type",
        "X-Event-ID"
      ],
      "properties": {
        "X-API-Key": {
          "type": "string",
          "pattern": "^gk_.+$"
        },
        "X-Request-ID": {
          "type": "string",
          "minLength": 1
        },
        "Content-Type": {
          "const": "application/json"
        },
        "X-Event-ID": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        }
      }
    },
    "telemetryHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "X-API-Key",
        "Content-Type",
        "X-Event-ID",
        "X-Logical-Node-Id"
      ],
      "properties": {
        "X-API-Key": {
          "type": "string",
          "pattern": "^gk_.+$"
        },
        "X-Request-ID": {
          "type": "string",
          "minLength": 1
        },
        "Content-Type": {
          "const": "application/json"
        },
        "X-Event-ID": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "X-Logical-Node-Id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "configurationHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "X-API-Key"
      ],
      "properties": {
        "X-API-Key": {
          "type": "string",
          "pattern": "^gk_.+$"
        },
        "X-Request-ID": {
          "type": "string",
          "minLength": 1
        },
        "X-Config-Version": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "X-Bindings-Revision": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "heartbeatHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "X-API-Key"
      ],
      "properties": {
        "X-API-Key": {
          "type": "string",
          "pattern": "^gk_.+$"
        },
        "X-Request-ID": {
          "type": "string",
          "minLength": 1
        },
        "X-Event-ID": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        }
      }
    }
  }
}
