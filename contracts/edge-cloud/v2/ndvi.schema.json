{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edge-cloud latest point NDVI v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "irrigation_area_id",
    "ndvi",
    "provider",
    "collection",
    "scene_id",
    "scene_observed_at",
    "cloud_cover_percent",
    "sample_method"
  ],
  "properties": {
    "irrigation_area_id": {
      "type": "integer",
      "minimum": 1
    },
    "ndvi": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "const": "sentinel-2-l2a"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "cloud_cover_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "sample_method": {
      "const": "point"
    }
  }
}
