# Environment
DEBUG=false
FRONTEND_PUBLIC_URL=http://localhost:5173

# Database
# DB_HOST: usa 127.0.0.1 en lugar de localhost para evitar problemas
# de conexión vía socket Unix (especialmente en Windows/WSL).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Esta contraseña debe coincidir con MYSQL_ROOT_PASSWORD en docker-compose.yml
# El valor por defecto definido en docker-compose es: rootpass
DB_PASSWORD=rootpass
DB_NAME=sensores_riego

# JWT — CHANGE THESE IN PRODUCTION
SECRET_KEY=CHANGE-ME-generate-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Fase 2 (DORMANT BY DEFAULT) ---
# Generacion de alertas de umbral durante la ingesta (Fase 2):
ALERTS_ENABLED=false

# Notifications (Direct backend delivery)
NOTIFICATIONS_ENABLED=false

# Ventana anti-duplicados para alertas de umbral.
# 10 = evita repetir la misma alerta (nodo+parametro+severidad) por 10 minutos.
# 0 = desactiva deduplicacion (util para demos en tiempo real).
ALERT_THRESHOLD_DUPLICATE_WINDOW_MINUTES=10

# Email (SMTP)
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NOTIFICATION_EMAIL_SUBJECT_PREFIX=[Sensores IoT]

# WhatsApp Cloud API
NOTIFICATIONS_WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_MESSAGE_MODE=text
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_HTTP_TIMEOUT_SECONDS=15
WHATSAPP_TEMPLATE_NAME=alerta_riego_critica_v1
WHATSAPP_TEMPLATE_LANGUAGE_CODE=es_MX

# WhatsApp via Twilio Content API (set WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_CONTENT_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_API_BASE_URL=https://api.twilio.com

# AI Reports (Phase 2 backend-first)
AI_REPORTS_ENABLED=false
AI_REPORTS_DEFAULT_NOTIFY=false
AI_REPORTS_SCHEDULER_ENABLED=false
AI_REPORTS_SCHEDULER_POLL_SECONDS=60
AI_REPORTS_SCHEDULE_HOUR_UTC=2
AI_REPORTS_SCHEDULE_MINUTE_UTC=0
AI_REPORTS_HTTP_TIMEOUT_SECONDS=30
AI_REPORTS_SCHEDULER_FORCE=false
AI_ALERT_RECOMMENDATIONS_ENABLED=false
AI_ALERT_RECOMMENDATIONS_MAX_RECENT_READINGS=48
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_MAX_AREAS=25
AI_ASSISTANT_MAX_ALERTS=40
AI_ASSISTANT_MAX_HISTORY_MESSAGES=8
AI_ASSISTANT_RATE_LIMIT_WINDOW_MINUTES=15
AI_ASSISTANT_RATE_LIMIT_MAX_REQUESTS=20

# Azure OpenAI
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_MAX_TOKENS=900
AZURE_OPENAI_TIMEOUT_SECONDS=30

# --- Gateway pairing (RFC 8628 device authorization) ---
# Dormido por defecto; activar con GATEWAY_PAIRING_ENABLED=true.
GATEWAY_PAIRING_ENABLED=false
# URL base pública que construye verification_uri (<base>/pair). Requerida si el flag está activo.
PAIRING_VERIFICATION_BASE_URL=
PAIRING_TTL_SECONDS=600
PAIRING_INTERVAL_SECONDS=5
PAIRING_SLOW_DOWN_SECONDS=5
PAIRING_MAX_INTERVAL_SECONDS=60
PAIRING_MAX_WRONG_CODE_ATTEMPTS=5
# Clave HMAC del user_code; si está vacía se deriva de SECRET_KEY.
PAIRING_CODE_HMAC_KEY=
